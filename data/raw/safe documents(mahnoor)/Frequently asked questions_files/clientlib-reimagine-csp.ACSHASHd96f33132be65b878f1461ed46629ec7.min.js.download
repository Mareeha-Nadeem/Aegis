/**
 * This file sets up the reimagine client side pricing namespace.
 */
if (!window.reimagine) {
  window.reimagine = {};
}
if (!window.reimagine.CSP) {
  window.reimagine.CSP = {};
}
if (!window.reimagine.CSP.Module) {
  window.reimagine.CSP.Module = {};
}
if (!window.reimagine.CSP.Instance) {
  window.reimagine.CSP.Instance = {};
}
/**
 * Constants for Skagit Reimagine CSP.
 */
window.reimagine.CSP.Module.Constants = {
  attributes: {
    cspRequest: 'data-rds-csp',
    cspContent: 'data-rds-csp-content'
  },
  events:{
    cpsRefreshed: 'CSPRefreshed',
    cspRefresh: 'CSPRefresh',
    cspHardRefresh: 'CSPHardRefresh'
  },
  logging: {
    tag: '[Reimagine][CSP]'
  },
  message: {
    inlinePriceDialog: 'inlinePriceDialog'
  }
}

/**
 * Process handler base class for process handlers to extend. This class
 * provides base functionality for caching responses, provides a way to track requests, 
 * and provides a process function to override.
 */
window.reimagine.CSP.Module.ProcessHandlerBase = class ProcessHandlerBase {

  constructor(type) {

    // Prevent direct instantiation of abstract base class.
    if (new.target === ProcessHandlerBase) {
      throw new Error('ProcessHandlerBase is an abstract class and cannot be instantiated directly. Please extend it instead.');
    }
    
    this.type = type; // The process type used for tagging pricing elements.
    this.cache = {}; // Process response cache.
    this.abortControllers = []; // Abort controllers for handling canceling requests.
  }

  /**
   * Clears the process cache.
   */
  clearCache() {
    this.cache = {};
  }
  
  /**
   * OVERRIDE THIS IN EXTENDING CLASSES.
   * This function,
   * 1. Takes a list of request items [{requestData, target, element}]
   * 2. Takes a list of pricing content key-value pairs.
   * 3. Applies the web component specific render data as a target attribute to the element.
   */
  async process(requestItems, pricingContent) {
    throw new Error('process() must be implemented by subclass');
  }
};

/**
 * Commercial process class for handling mapping from request items to render data
 * using the commercial data connector.
 */
window.reimagine.CSP.Module.CommercialProcessHandler = class CommercialProcessHandler extends window.reimagine.CSP.Module.ProcessHandlerBase {

  // Response codes.
  SUCCESS = 'Success';
  NOT_FOUND = 'NotFound';
  NOT_AVAILABLE = 'NoAvailableSku';
  DISABLED_MARKET = 'DisabledMarket';

  constructor() {
    super("commercial");
    this._batchSize = 5; // Number of queries per batch.
    this.requestRetries = 3; // Number of failed request retires.
    this.locale = window.reimagine.utils.getPageLocale();
  }

  /**
   * Processes request items and adds the target attribute render data.
   * @param requestItems - An array of request items.
   * @param pricingContent - A map of pricing content.
   */
  async process(requestItems, pricingContent) {

    // Build render data for already cached queries.
    this._buildRenderData(requestItems, pricingContent);

    // Get unique request query request item groups.
    const uniqueRequestQueryGroups = this._getUniqueRequestQueryGroups(requestItems);

    // Fetch, cache, and update request item elements using data from the data connector.
    await this._fetchPricingData(uniqueRequestQueryGroups);
  }

  /**
   * Creates a map of unique request queries to request items list.
   * @param requestItems - An array of request items.
   * @returns - A map of unique request queries to request items list.
   */
  _getUniqueRequestQueryGroups(requestItems) {
    const uniqueRequestQueryGroups = {};
    requestItems.forEach(item => {
      const query = item.requestData.requestQuery;
      if (query) {
        if (!uniqueRequestQueryGroups[query]) {
          uniqueRequestQueryGroups[query] = [];
        }
        uniqueRequestQueryGroups[query].push(item);
      }
    });
    return uniqueRequestQueryGroups;
  }
   
  /**
   * Fetches pricing data from the data connector, caches responses, and updates request item elements.
   * @param uniqueRequestQueryGroups - A map of unique request queries to request items list.
   */
  async _fetchPricingData(uniqueRequestQueryGroups) {
    
    // Cancel all previous requests.
    this._cancelActiveRequests();
    
    // Add an abort controller to keep track of requests.
    const controller = new AbortController();
    this.abortControllers.push(controller);

    // Fetch uncached query batches.
    const batches = this._getUncachedBatches(uniqueRequestQueryGroups);
    batches.forEach(batchItem => {
      this._fetchWithRetry(async () => {
        
        // Fetch the batch data.
        const dataArray = await this._fetchBatch(batchItem, controller.signal);
        this._cacheResponses(dataArray);

        // Build the render data for the group after the response.
        batchItem.forEach(([_, requestItems]) => {
          this._buildRenderData(requestItems);
        });
      }, this._requestRetries)
      .catch((err) => {
        if (err.name != 'AbortError') {
          console.warn(`Pricing request batch failed.`);
        }
      });
    });
  }

  /**
   * Cancels all ongoing requests.
   */
  _cancelActiveRequests() {
    this.abortControllers.forEach(controller => controller.abort());
    this.abortControllers = [];
  }

  /**
   * Builds an array of query request groups for uncached queries.
   * @param uniqueRequestQueryGroups - A set of unique request queries.
   * @returns - An array of batches of uncached query groups.
   */  
  _getUncachedBatches(uniqueRequestQueryGroups) {
    
    const batches = [];
    const entries = Object.entries(uniqueRequestQueryGroups);
    for (let i = 0; i < entries.length; i += this._batchSize) {
      const batch = entries
        .slice(i, i + this._batchSize)
        .filter(([queryKey]) => !this.cache[queryKey]); // Use key for cache check

      if (batch.length > 0) {
        batches.push(batch);
      }
    }

    return batches;
  }

  /**
   * Retries fetch requests.
   * @param fn - Function to call
   * @param retries - Number of retries
   * @param delay - Delay between retries
   */
  async _fetchWithRetry(fn, retries = 3, delay = 500) {
    for (let attempt = 1; attempt <= retries; attempt++) {
      try {
        return await fn();
      } catch (err) {
        // Stop retrying if the request is canceled or out of attempts. 
        if (attempt === retries || err.name === 'AbortError') throw err;
        await new Promise(res => setTimeout(res, delay));
      }
    }
  }
  
  /**
   * Fetches pricing data from the data connector given a batch of queries.
   * @param batch - Batch to fetch.
   * @returns - Data connector response.
   */
  async _fetchBatch(batch, signal) {
    const combinedQuery = batch.map((batchItem) => encodeURIComponent(batchItem[0])).join('%2C');
    const endpoint =  window.reimagine.utils.getDataConnectorEndpoint('/m365/product/price', `v=4&r=json&llcc=${this.locale}&q=${combinedQuery}`);
    const response = await fetch(endpoint, {signal});
    return response.json();
  }

  /**
   * Caches response data by unique query.
   * @param responseData - Response data from the data connector. 
   */
  _cacheResponses(responseData) {
    responseData.forEach(item => {
      const query = item.puid;
      this.cache[query] = item;
    });
  }

  /**
   * Builds render data from request and cached response data.
   * @param requestItems - A list of request items.
   * @param pricingContent - A map of pricing content.
   */
  _buildRenderData(requestItems, pricingContent) {

    requestItems.forEach((item) => {
      const requestData = item.requestData;
      const responseData = this.cache[requestData.requestQuery];
      if (!responseData || !requestData) return;

      // Normalize the pricing data that is used for building render data.
      const normalizedData = this._normalizePricingData(requestData, responseData, pricingContent);

      // Set the target attribute.
      item.elem.setAttribute(item.target, JSON.stringify(normalizedData))
    });
  }

  /**
   * Normalizes request data and response data into a single pricing data object for reference
   * when building the render data object. This is required because some render data is provided
   * as part of the request and only renders based on response data.
   * @param requestData - Request data.
   * @param responseData - Data connector response data.
   * @param pricingContent - A map of pricing content.
   * @returns - Normalized pricing data.
   */
  _normalizePricingData(requestData, responseData, pricingContent) {

    const responseCode = responseData.responseCode;
    let normalizedData = {};

    // Disabled market.
    if (responseCode == this.DISABLED_MARKET) {
      normalizedData[requestData.titleKey || 'title'] = responseData.title;
      normalizedData[requestData.unavailableTextKey || 'unavailableText'] = 
        pricingContent['embargo-message'];
      return normalizedData;
    } 
    
    // Not found or not available.
    if (responseCode != this.SUCCESS) {
      // If failure on tokenType request, return error message to user as tax disclaimer so it renders
      if (requestData.tokenType) {
        return this._normalizeTokenPricingData('tax-disclaimer', null, null, "[error: product not found or not available, verify pricing authoring]", requestData);
      }

        pricingContent['unavailable-message'];
      return normalizedData;
    } 

    const sku = responseData.sku;

    // Title.
    let normalizedTitle = requestData.titleOverride ?
      requestData.titleOverride :
      requestData.isUsingProductTitle ?
        responseData.title : sku.title;

    // Tokens for inline price data
    if (requestData.tokenType) {
      return this._normalizeTokenPricingData(requestData.tokenType, sku, normalizedTitle, pricingContent['tax-disclaimer'], requestData);
    }

    // Title.
    normalizedData[requestData.titleKey || 'title'] = normalizedTitle;

    // Is discounted
    normalizedData[requestData.isDiscountedKey || 'isDiscounted'] = sku.msrpPrice != sku.listPrice;

    // Current Price, MSRP, and discount.
    normalizedData[requestData.currentPriceKey || 'currentPrice'] = sku.displayListPrice;
    normalizedData[requestData.discountKey || 'discount'] = sku.displayDiscountPrice;
    normalizedData[requestData.msrpPriceKey || 'msrpPrice'] = sku.displayMSRPPrice;

    return normalizedData;
  }

  /**
   * Return normalized data based on token types.
   * @param tokenType - Token type.
   * @param sku - SKU data, to add pricing values.
   * @param title - Title.
   * @param taxDislcaimer - Tax dislcaimer.
   * @param requestData - Request data.
   * @returns - Normalized pricing data for tokens.
   */
  _normalizeTokenPricingData(tokenType, sku, title, taxDislcaimer, requestData) {
    let normalizedData = {};

    // Tokens for inline price data
    normalizedData['tokenType'] = tokenType;

    switch (tokenType)
    {
      case 'product-title':
      case 'sku-title': {
        normalizedData[requestData.titleKey || 'title'] = title;
        break;
      }
      case 'list-price': {
        normalizedData[requestData.currentPriceKey || 'currentPrice'] = sku.displayListPrice;
        break;
      }
      case 'msrp-price': {
        normalizedData[requestData.msrpPriceKey || 'msrpPrice'] = sku.displayMSRPPrice;
        break;
      }
      case 'discount-price': {
        normalizedData[requestData.discountKey || 'discount'] = sku.displayDiscountPrice;
        break;
      }
      case 'tax-disclaimer': {
        normalizedData[requestData.unavailableTextKey || 'unavailableText'] = taxDislcaimer;
        break;
      }
      case 'promo-price': {
        normalizedData[requestData.currentPriceKey || 'currentPrice'] = sku.displayListPrice;
        normalizedData[requestData.msrpPriceKey || 'msrpPrice'] = sku.displayMSRPPrice;
        break;
      }
    }

    return normalizedData;
  }
};
/**
 * Process service class to handle registering processes, querying pricing elements,
 * processing elements by handler groups, and clearing all process caches.
 */
window.reimagine.CSP.Module.ProcessService = class ProcessService {

  /**
   * Component Service constructor.
   * @param {CSP.Module.Constants} constants - CSP constants.
   */
  constructor(constants) {
    this._constants = constants;
    this._handlers = {};
  }

  /**
   * Registers a component type handler.'
   * @param handlerInstance - Instance of a class that extends ProcessHandlerBase.
   */
  registerHandler(handlerInstance) {
    this._handlers[handlerInstance.type] = handlerInstance;
  }

  /**
   * Clears all handlers cache.
   */
  clearAllHandlerCache() {
    Object.values(this._handlers).forEach(handler => {
      if (handler && typeof handler.clearCache === 'function') {
        handler.clearCache();
      }
    });
  }

  /**
   * Processes pricing component elements with corresponding handlers.
   */
  processElements() {
    
    // Query all pricing components.
    const componentElems = this._queryPricingComponents()

    // Iterate over all pricing components and group by handler type.
    let elemProcessGroups = this._groupByHandlerType(componentElems);

    // Process the grouped elements with registered handlers.
    this._processElemGroups(elemProcessGroups);
  }

  /**
   * Queries all pricing component elements on the page.
   * @returns - An array of pricing component elements.
   */
  _queryPricingComponents() {
    return window.parent.document.querySelectorAll(`[${this._constants.attributes.cspRequest}]`);
  }

  /**
   * Builds a content map from the CSP content element. Each attribute on the element is parsed
   * as a key-value pair in the content map where the key is the attribute name without the prefix
   * and the value is the attribute value.
   * @returns - A map grouped by pricing group.
   */
  _buildContentMap() {
    const contentElem = document.querySelector(`[${this._constants.attributes.cspContent}]`);
    const contentMap = {};
    if (contentElem) {
      Array.from(contentElem.attributes).forEach(attr => {
        const attrNameParts = attr.name.split('-');
        if (attrNameParts.length < 2 || attrNameParts[0] == 'data') return;
        const groupKey = attrNameParts[0];
        if (!contentMap[groupKey]) {
          contentMap[groupKey] = {};
        }
        const contentKey = attrNameParts.slice(1).join('-');
        contentMap[groupKey][contentKey] = attr.value;
      });
    }
    return contentMap;
  }

  /**
   * Groups elements by handler type.
   * @param componentElems - Array of component elements.
   * @returns - A map of data and element pairs by handler type.
   */
  _groupByHandlerType(componentElems) {
    
    let groups = {};
    componentElems.forEach((elem) => {

      try {
        // Get the request data from the element.
        const encodedCSPRequestData = elem.getAttribute(this._constants.attributes.cspRequest);
        const cspRequestData = JSON.parse(decodeURIComponent(encodedCSPRequestData.replace(/\+/g, ' ')));

        // Slot the element into groups by handler type.
        if (!groups[cspRequestData.type]) {
          groups[cspRequestData.type] = [];
        }
        groups[cspRequestData.type].push({ 
          requestData: cspRequestData.data,
          target: cspRequestData.target, 
          elem: elem
        });
      } catch (e) {
        console.warn(`${this._constants.logging.tag} - ${elem} does not have valid request json.`);
      }
    });

    return groups;
  }

  /**
   * Processes component element groups with corresponding handlers.
   * @param groups - Map of component element groups by process. 
   */
  _processElemGroups(groups) {

    let pricingContent = this._buildContentMap();

    // Iterate over the groups.
    Object.keys(groups).forEach(async (type) => {
      const handler = this._handlers[type];
      if (handler) {

        // Process the groups with the corresponding handler.
        handler.process(groups[type], pricingContent[type] || {});
      }
    });
  }

  _
};
/**
 * Event manager class for listening for CSP events and dispatching
 * a custom CSP complete event.
 */
window.reimagine.CSP.Module.EventManager = class EventManager {

  /**
   * Event manager constructor
   * @param {CSP.Module.ProcessService} processService- Component utils.
   * @param {CSP.Module.Constants} constants - CSP constants.
   */
  constructor(processService, constants) {
    this._processService = processService;
    this._constants = constants;
    this._bindEventHandlers();
    this._listenForEvents();
  }

  /**
   * Binds this to event handlers.
   */
  _bindEventHandlers() {
    this._refreshPricing = this._refreshPricing.bind(this);
    this._hardRefreshPricing = this._hardRefreshPricing.bind(this);
  }

  /**
   * Listens for events and calls event handlers.
   */
  _listenForEvents() {

    if (!this._constants) return;

    // Listen for page load event.
    document.readyState == 'loading' ?
      document.addEventListener('DOMContentLoaded', this._refreshPricing) :
      this._refreshPricing();

    // CSP refresh event
    document.addEventListener(this._constants.events.cspRefresh, () => {this._refreshPricing()});

    // CSP hard refresh event.
    document.addEventListener(this._constants.events.cspHardRefresh, () => {this._hardRefreshPricing()});

    // Listen for message from inlinePriceDialog sender to refresh pricing.
    window.addEventListener('message', (event) => {
      const message = event.data;
      if (message?.sender === this._constants.message.inlinePriceDialog && message.event === this._constants.events.cspRefresh) {
        this._refreshPricing();
      }
    });
  }

  /**
   * Refreshes all pricing components with cached or new pricing data.
   */
  async _refreshPricing() {
    if (!this._processService) return;
    this._processService.processElements();
    this._dispatchPricingRefreshedEvent();
  }

  /**
   * Refreshes all pricing components with new pricing data.
   */
  async _hardRefreshPricing() {
    if (!this._processService) return;
    this._processService.clearAllHandlerCache();
    this._refreshPricing();
  }

  /**
   * Dispatches a custom event to alert that CSP has refreshed prices.
   */
  _dispatchPricingRefreshedEvent() {
    document.dispatchEvent(new CustomEvent(this._constants.events.pricingRefreshed));
  }
};

/**
 * This file initializes the client side pricing services, handlers & managers with dependencies.
 */
(() => {

  // Services.
  const processService = new window.reimagine.CSP.Module.ProcessService(
    window.reimagine.CSP.Module.Constants
  );

  // Handlers.
  processService.registerHandler(new window.reimagine.CSP.Module.CommercialProcessHandler());

  // Managers.
  const eventManager = new window.reimagine.CSP.Module.EventManager(
    processService, 
    window.reimagine.CSP.Module.Constants
  );

  // CSP Instance.
  window.reimagine.CSP.Instance = {
    eventManager: eventManager,
    processService: processService
  }
})();